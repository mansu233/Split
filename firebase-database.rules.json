{
  "rules": {
    "manskit_split_backups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$syncId": {
        ".validate": "newData.hasChildren(['version', 'profiles', 'activeProfileId', 'updatedAt']) && newData.child('profiles').isList()"
        }
      }
    }
  }
}
